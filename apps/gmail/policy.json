{
  "targetDomains": [
    "mail.google.com",
    "calendar.google.com"
  ],
  "telemetryAllow": [
    "/gen_204",
    "/log?",
    "/logstreamz",
    "/jserror",
    "/_/mail/logging",
    "/csi",
    "/beacon",
    "play.google.com/log",
    "google.internal.waa.v1.Waa",
    "/mail/cspreport"
  ],
  "blockedGetPaths": [
    "action=RESPOND",
    "/calendar/event?action=RESPOND"
  ],
  "websockets": "block",
  "blockedShapes": [
    "gcal:sync:w",
    "gtasks:sync:w",
    "gmail:s:w"
  ]
}
