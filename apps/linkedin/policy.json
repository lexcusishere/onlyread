    "li:rsc:w[sharing.LaunchSharebox]",
    "li:rsc:w[requests.updateSearchHistoryRequest]",
    "li:rsc:w[sharing.TrackShareboxInteraction]",
    "li:rsc:w[sharing.collaboratorResetOnDiscardAction]"
