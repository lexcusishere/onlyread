{
  "websockets": "block",
  "targetDomains": [
    "linkedin.com"
  ],
  "telemetryAllow": [
    "/li/track",
    "/platform-telemetry/",
    "/lite/track",
    "/sensorCollect",
    "/li/ct",
    "/litms/",
    "realtimeFrontendClientConnectivityTracking",
    "/to11y*",
    "/tapi*",
    "/tlix*",
    "/tmed*",
    "perf.linkedin.com",
    "px.ads.linkedin.com",
    "merchantpool",
    "/collect",
    "/analytics",
    "/telemetry",
    "/rum",
    "re:^www\\.linkedin\\.com/(?=[^/?]*[A-Z])(?=[^/?]*[a-z])[A-Za-z0-9_-]{10,20}$"
  ],
  "blockedGetPaths": [],
  "blockedShapes": [
    "gcal:sync:w",
    "gtasks:sync:w",
    "gmail:s:w",
    "li:rsc:w",
    "li:msgbadge:w",
    "li:msg:w"
