    "li:rsc:w[mynetwork.addaMarkNotificationsSeen]",
    "li:rsc:w[notifications.markNotificationsSeen]",
    "li:rsc:w[profile.profilePolicyNotice]",
    "li:msgbadge:w[seen]",
    "li:msg:w[typing]",
    "li:msg:w[read]",
    "li:msg:w[delivered]"
  ],
  "readPutPaths": [
    "/realtime/realtimeFrontendSubscriptions"
  ]
}
