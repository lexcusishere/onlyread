  "hasBody": true,
  "expected": "POST localhost/graphql gql:mutation:CreateItem"
 },
 {
  "name": "graphql: the operation operationName selects decides the kind, not the first keyword",
  "method": "POST",
  "url": "http://localhost/graphql",
  "contentType": "application/json",
  "body": "{\"operationName\":\"SearchAll\",\"query\":\"query Pad { viewer { id } } mutation SearchAll { issueDelete(id: \\\"ISSUE-1\\\") { success } }\"}",
  "hasBody": true,
  "expected": "POST localhost/graphql gql:mutation:SearchAll"
 },
 {
  "name": "graphql: several operations and none named is unknown",
  "method": "POST",
  "url": "http://localhost/graphql",
  "contentType": "application/json",
  "body": "{\"query\":\"query A { a } mutation B { b }\"}",
  "hasBody": true,
  "expected": "POST localhost/graphql gql:unknown:-"
 },
 {
  "name": "graphql: an operationName the document does not define is unknown",
  "method": "POST",
  "url": "http://localhost/graphql",
  "contentType": "application/json",
  "body": "{\"operationName\":\"SearchAll\",\"query\":\"mutation Other { issueDelete(id: \\\"1\\\") { success } }\"}",
  "hasBody": true,
  "expected": "POST localhost/graphql gql:unknown:SearchAll"
 },
 {
  "name": "graphql: fragments, comments and strings do not count as operations",
  "method": "POST",
  "url": "http://localhost/graphql",
  "contentType": "application/json",
  "body": "{\"operationName\":\"Q\",\"query\":\"# mutation X { y }\\nquery Q($s: String = \\\"} mutation {\\\") { ...F } fragment F on T { a }\"}",
  "hasBody": true,
  "expected": "POST localhost/graphql gql:query:Q"
 },
 {
  "name": "graphql batch mixed",
  "method": "POST",
  "url": "http://localhost/graphql",
  "contentType": "application/json",
  "body": "[{\"query\":\"query { a }\"},{\"query\":\"mutation { b }\"}]",
  "hasBody": true,
  "expected": "POST localhost/graphql gql[]:query,mutation"
 },
 {
  "name": "graphql raw content type",
